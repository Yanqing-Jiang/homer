#!/usr/bin/env node
import { randomUUID } from "node:crypto";
import { homedir } from "node:os";
import { execFile } from "node:child_process";
import { BrowserProcessGroups } from "./browser-process-groups.mjs";
import { readFile } from "node:fs/promises";
import { createConnection } from "node:net";
import readline from "node:readline";

const socketPath = process.env.HOMER_BROWSER_CONTROL_SOCKET
  ?? `${homedir()}/Library/Application Support/Homer/cdp-state/browser-control.sock`;
const statusPath = process.env.HOMER_BROWSER_STATUS_FILE
  ?? `${homedir()}/Library/Application Support/Homer/cdp-state/status.json`;
const agentBrowser = process.env.HOMER_AGENT_BROWSER_BIN ?? "/opt/homebrew/bin/agent-browser";
let cdpBase = "http://127.0.0.1:9222";
const [command, ...args] = process.argv.slice(2);

function usage() { throw new Error("usage: browserctl status [surface] | acquire <surface> <owner> <ttl-seconds> | acquire-external <agent.surface> <owner> <ttl-seconds> [--grant] | capabilities | release-grant <leaseId> | renew <leaseId> <ttl-seconds> | release <leaseId> | reconcile <surface> <origin[,origin...]> <bootstrapUrl> | touch <surface> | maintenance <on|off> [reason] | agent [agent.surface] [--ttl seconds] [--adopt <leaseId>] [--instance downloads|interactive] [--rpc | -- <workflow command...>]"); }

async function readStatus(surface) {
  const now = Date.now();
  let snapshot;
  try {
    snapshot = JSON.parse(await readFile(statusPath, "utf8"));
  } catch (error) {
    return { ok: false, state: "unhealthy", surface: surface ?? null, reasons: [`status.json unreadable: ${error.message}`] };
  }
  const reasons = [];
  const updatedAtMs = Date.parse(snapshot.updatedAt);
  const ageSeconds = Number.isFinite(updatedAtMs) ? Math.max(0, (now - updatedAtMs) / 1000) : null;
  if (ageSeconds === null) reasons.push("status.json updatedAt is invalid");
  else if (ageSeconds > 90) reasons.push(`status.json is stale (${Math.round(ageSeconds)}s > 90s)`);
  if (snapshot.cdp?.state !== "ready") reasons.push(`CDP is ${snapshot.cdp?.state ?? "unknown"}`);

  let surfaceStatus = null;
  let surfaceAgeSeconds = null;
  if (surface) {
    surfaceStatus = snapshot.surfaces?.[surface] ?? null;
    if (!surfaceStatus) {
      reasons.push(`surface ${surface} is absent`);
    } else {
      const probedAtMs = Date.parse(surfaceStatus.lastProbeAt);
      surfaceAgeSeconds = Number.isFinite(probedAtMs) ? Math.max(0, (now - probedAtMs) / 1000) : null;
      if (surfaceAgeSeconds === null) reasons.push(`surface ${surface} has no valid lastProbeAt`);
      else if (surfaceAgeSeconds > 8 * 60 * 60) reasons.push(`surface ${surface} is stale (${Math.round(surfaceAgeSeconds)}s > 8h)`);
      if (surfaceStatus.state !== "authenticated") reasons.push(`surface ${surface} is ${surfaceStatus.state ?? "unknown"}`);
    }
  }
  return {
    ok: reasons.length === 0,
    state: reasons.length === 0 ? "healthy" : "unhealthy",
    surface: surface ?? null,
    ageSeconds,
    surfaceAgeSeconds,
    reasons,
    status: snapshot,
  };
}

function requestBroker(request) {
  return new Promise((resolve, reject) => {
    const socket = createConnection(socketPath);
    let output = "";
    socket.setEncoding("utf8");
    socket.on("connect", () => socket.write(`${JSON.stringify(request)}\n`));
    socket.on("data", (chunk) => {
      output += chunk;
      if (!output.includes("\n")) return;
      try {
        const response = JSON.parse(output.slice(0, output.indexOf("\n")));
        if (!response.ok) reject(new Error(response.error)); else resolve(response.result);
      } catch (error) { reject(error); }
      socket.end();
    });
    socket.on("error", reject);
    socket.on("close", () => { if (!output) reject(new Error("broker closed without a response")); });
  });
}

const driverGroups = new BrowserProcessGroups(`${socketPath}.drivers.${process.pid}.json`);
function runFile(file, fileArgs, options = {}) {
  return new Promise((resolve, reject) => {
    let stdout = "", stderr = "", timer;
    const child = driverGroups.spawn(file, fileArgs, { env: options.env, stdio: ["ignore", "pipe", "pipe"] });
    child.stdout.on("data", data => { stdout += data; if (stdout.length > 32 * 1024 * 1024) { stopRequested = true; void driverGroups.stop(); } });
    child.stderr.on("data", data => { stderr += data; if (stderr.length > 32 * 1024 * 1024) { stopRequested = true; void driverGroups.stop(); } });
    if (options.timeout) timer = setTimeout(() => { stopRequested = true; void driverGroups.stop(); }, options.timeout);
    child.once("error", error => { clearTimeout(timer); reject(error); });
    child.once("close", (code, signal) => {
      clearTimeout(timer);
      if (code !== 0 || signal || stopRequested) reject(Object.assign(new Error(`browser command failed (${signal ?? code}): ${stderr}`), { stderr }));
      else resolve(stdout);
    });
  });
}
// Closing the named daemon is cleanup, and remains allowed after command admission stops.
function closeSession(session) {
  return new Promise(resolve => execFile(agentBrowser, ["--session", session, "close"], { timeout: 10_000 }, () => resolve()));
}

async function listPageTargets() {
  const response = await fetch(`${cdpBase}/json/list`);
  if (!response.ok) throw new Error(`CDP target list failed: HTTP ${response.status}`);
  return (await response.json()).filter((target) => target.type === "page");
}

async function runChild(file, childArgs, env, input) {
  return await new Promise((resolve, reject) => {
    const child = driverGroups.spawn(file, childArgs, { env, stdio: ["pipe", "inherit", "inherit"] });
    child.once("error", reject);
    child.once("exit", (code, signal) => { resolve(code ?? (signal ? 1 : 0)); });
    if (input === undefined) process.stdin.pipe(child.stdin); else child.stdin.end(input);
  });
}

let stopRequested = false;

async function runRpc(session, env) {
  const rl = readline.createInterface({ input: process.stdin, crlfDelay: Infinity });
  process.stdout.write(`${JSON.stringify({ ready: true, session })}\n`);
  for await (const line of rl) {
    if (stopRequested) break;
    if (!line.trim()) continue;
    try {
      const request = JSON.parse(line);
      if (!Array.isArray(request.args)) throw new Error("rpc request requires args array");
      const stdout = await runFile(agentBrowser, ["--session", session, ...request.args], { env, timeout: request.timeoutMs ?? 120_000 });
      process.stdout.write(`${JSON.stringify({ id: request.id, ok: true, stdout })}\n`);
    } catch (error) {
      process.stdout.write(`${JSON.stringify({ id: (() => { try { return JSON.parse(line).id; } catch { return undefined; } })(), ok: false, error: error.message })}\n`);
    }
  }
  return 0;
}

async function runAgent(agentArgs) {
  let surface = `agent.${randomUUID()}`;
  let ttl = 3600;
  let rpc = false;
  let workflow = [];
  let adoptLeaseId = null;
  let instance = null;
  let i = 0;
  if (agentArgs[0] && !agentArgs[0].startsWith("-")) surface = agentArgs[i++];
  while (i < agentArgs.length) {
    if (agentArgs[i] === "--ttl") { ttl = Number(agentArgs[++i]); i++; }
    else if (agentArgs[i] === "--instance") { instance = agentArgs[++i]; i++; }
    else if (agentArgs[i] === "--adopt") { adoptLeaseId = agentArgs[++i]; i++; }
    else if (agentArgs[i] === "--rpc") { rpc = true; i++; }
    else if (agentArgs[i] === "--") { workflow = agentArgs.slice(i + 1); break; }
    else usage();
  }
  if (instance && instance !== "downloads") {
    const capabilities = await requestBroker({ verb: "capabilities" });
    if (!capabilities.instances?.includes(instance)) {
      throw new Error(`running broker does not support instance ${instance}; activate the new daemon before using it`);
    }
  }
  const owner = `browserctl-agent:${process.pid}`;
  // A caller that already reserved the browser (ABVP does, so the agent stage cannot be
  // spent on a browser someone else took between the check and the launch) passes its
  // leaseId as a grant. We ADOPT that reservation rather than racing for a new one.
  //
  // Two delivery channels, because relying on an LLM to reproduce a CLI flag verbatim is not
  // a mechanism: an explicit `--adopt <id>`, and HOMER_BROWSER_GRANT inherited from the
  // holder's environment. An explicit flag FAILS CLOSED if adoption is refused (the caller
  // asked for this lease and nothing else will do). An inherited env grant falls back to a
  // normal reservation, so an unrelated job that merely inherited the variable still works;
  // the broker binds the grant to its surface, so it cannot be stolen either way.
  const explicitGrant = adoptLeaseId ?? null;
  const envGrant = process.env.HOMER_BROWSER_GRANT ?? null;
  const grant = explicitGrant ?? envGrant;
  // Short suffix: agent-browser session names become socket paths (103-byte
  // cap), and the default surface already carries a full UUID.
  const session = `homer-${surface.replace(/[^a-zA-Z0-9_-]/g, "-")}-${randomUUID().slice(0, 8)}`;
  let leaseId;
  let targetId;
  let renewTimer;
  let adoptedGrant = false;
  const stop = () => { stopRequested = true; void driverGroups.stop(); process.stdin.destroy(); };
  process.once("SIGTERM", stop);
  process.once("SIGINT", stop);
  try {
    let baselineTargetIds;
    let adopted = null;
    if (grant) {
      try {
        adopted = await requestBroker({ verb: "adopt-external", leaseId: grant, owner, surface, ...(instance ? { instance } : {}) });
      } catch (error) {
        // An OLD daemon answers "unknown verb: adopt-external". Say so explicitly rather than
        // failing with an opaque message after the caller has already paid for a reservation.
        if (/unknown verb/.test(error.message ?? "")) {
          throw new Error(
            `this browserctl supports browser grants but the running daemon does not ` +
              `(${error.message}). Restart the Homer daemon to pick up the new broker, or run without a grant.`,
          );
        }
        if (explicitGrant || instance) throw error;   // asked for this lease explicitly: fail closed
        adopted = null;                   // merely inherited the env: fall back below
      }
    }
    if (adopted) {
      leaseId = adopted.leaseId;
      instance = adopted.instance ?? "downloads";
      cdpBase = adopted.cdpEndpoint ?? "http://127.0.0.1:9222";
      surface = adopted.surface ?? surface;
      adoptedGrant = adopted.granted === true;
      baselineTargetIds = (await listPageTargets()).map((target) => target.id);
    } else {
      const reserved = await requestBroker({ verb: "reserve-external", surface, owner, ttl, ...(instance ? { instance } : {}) });
      instance = reserved.instance ?? "downloads";
      cdpBase = reserved.cdpEndpoint ?? "http://127.0.0.1:9222";
      leaseId = reserved.leaseId;
      baselineTargetIds = reserved.baselineTargetIds;
    }
    const baseline = new Set(baselineTargetIds);
    await runFile(agentBrowser, ["--session", session, "connect", new URL(cdpBase).port], { timeout: 30_000 });
    const marker = `about:blank#homer-agent-${randomUUID()}`;
    await runFile(agentBrowser, ["--session", session, "tab", "new", marker], { timeout: 30_000 });
    const created = (await listPageTargets()).filter((target) => !baseline.has(target.id));
    if (created.length !== 1) throw new Error(`expected one new agent target, observed ${created.length}`);
    targetId = created[0].id;
    const currentUrl = (await runFile(agentBrowser, ["--session", session, "get", "url"], { timeout: 10_000 })).trim();
    if (currentUrl !== marker || created[0].url !== marker) throw new Error("named session did not remain bound to its created target");
    await requestBroker({ verb: "register-external-target", leaseId, targetId });
    if (!adoptedGrant) renewTimer = setInterval(() => { void requestBroker({ verb: "renew", leaseId, ttl }).catch((error) => { process.stderr.write(`browser lease renewal failed: ${error.message}\n`); stop(); }); }, Math.min(30_000, ttl * 500));
    const env = { ...process.env, AGENT_BROWSER_SESSION: session, HOMER_BROWSER_SURFACE: surface, HOMER_BROWSER_TARGET_ID: targetId, HOMER_BROWSER_INSTANCE: instance, HOMER_CDP_HTTP: cdpBase };
    const code = rpc ? await runRpc(session, env)
      : workflow.length ? await runChild(workflow[0], workflow.slice(1), env)
      : await runChild(agentBrowser, ["--session", session, "batch", "--bail"], env);
    return stopRequested ? 143 : code;
  } finally {
    if (renewTimer) clearInterval(renewTimer);
    await closeSession(session);
    if (!await driverGroups.stop()) {
      process.stderr.write("browser command group has not exited; retaining lease and wrapper as an admission fence\n");
      // Retain the live lease owner until the OS proves all owned groups gone.
      while (!await driverGroups.stop()) await new Promise(resolve => setTimeout(resolve, 1000));
    }
    // Release our tab. When the lease came from a GRANT the broker keeps the holder's
    // reservation alive (it answers grantRetained), so the holder still has admission for
    // its next phase and the agent can be relaunched — the MFA-recovery flow depends on it.
    if (leaseId) await requestBroker({ verb: "release", leaseId, closeTarget: Boolean(targetId), targetId }).catch(() => undefined);
    process.removeListener("SIGTERM", stop);
    process.removeListener("SIGINT", stop);
  }
}

try {
  if (command === "status" && args[0] === "--instance" && args[1] && args[1] !== "downloads") {
    process.stdout.write(`${JSON.stringify(await requestBroker({ verb: "status", instance: args[1] }))}\n`);
  } else if (command === "status" && (args.length <= 1 || (args[0] === "--instance" && args[1] === "downloads"))) {
    const result = await readStatus(args[0] === "--instance" ? undefined : args[0]);
    process.stdout.write(`${JSON.stringify(result)}\n`);
    if (!result.ok) process.exitCode = 1;
  } else if (command === "agent") {
    process.exitCode = await runAgent(args);
  } else {
    let request;
    if (command === "acquire" && args.length === 3) request = { verb: command, surface: args[0], owner: args[1], ttl: Number(args[2]) };
    else if (command === "renew" && args.length === 2) request = { verb: command, leaseId: args[0], ttl: Number(args[1]) };
    else if (command === "release" && args.length === 1) request = { verb: command, leaseId: args[0] };
    // Take an external agent reservation WITHOUT launching an agent, so a caller can reserve
    // the browser first and hand the leaseId to the agent as a grant (`agent --adopt`).
    else if (command === "capabilities" && args.length === 0) request = { verb: "capabilities" };
    else if (command === "acquire-external" && (args.length === 3 || (args.length === 4 && args[3] === "--grant"))) request = { verb: "reserve-external", surface: args[0], owner: args[1], ttl: Number(args[2]), granted: args[3] === "--grant" };
    // Drop a granted reservation. Only the holder calls this; an adopter's `release` keeps it.
    else if (command === "release-grant" && args.length === 1) request = { verb: "release-grant", leaseId: args[0] };
    else if (command === "reconcile" && args.length === 3) request = { verb: command, surface: args[0], expectedOrigin: args[1].split(","), bootstrapUrl: args[2] };
    else if (command === "touch" && args.length === 1) request = { verb: command, surface: args[0] };
    else if (command === "maintenance" && args.length >= 1 && ["on", "off"].includes(args[0])) request = { verb: command, enabled: args[0] === "on", reason: args.slice(1).join(" ") || "browserctl" };
    else usage();
    process.stdout.write(`${JSON.stringify(await requestBroker(request))}\n`);
  }
} catch (error) {
  process.stderr.write(`${error.message}\n`);
  process.exitCode = 1;
}
